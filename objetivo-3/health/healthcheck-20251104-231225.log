==== 6) Descripción (probes y mounts) - mysql secondary ====


$ kubectl -n bookstore describe statefulset mysql-bookstore-secondary | sed -n '/Containers:/,/Conditions:/p'

  Containers:
   mysql:
    Image:      mysql:8.4
    Port:       3306/TCP
    Host Port:  0/TCP
    Command:
      bash
      -lc
    Args:
      set -e
      ORD=${HOSTNAME##*-}
      SID=$((100 + ORD))
      echo "Usando server-id=${SID} para ${HOSTNAME}"
      exec docker-entrypoint.sh mysqld \
        --server-id=${SID} \
        --relay-log=relay-bin \
        --gtid_mode=ON \
        --enforce-gtid-consistency=ON \
        --read_only=ON
      
    Liveness:   exec [bash -lc mysqladmin --protocol=TCP -h 127.0.0.1 -p"$MYSQL_ROOT_PASSWORD" ping] delay=50s timeout=1s period=10s #success=1 #failure=3
    Readiness:  exec [bash -lc mysqladmin --protocol=TCP -h 127.0.0.1 -p"$MYSQL_ROOT_PASSWORD" ping] delay=25s timeout=1s period=5s #success=1 #failure=3
    Environment:
      MYSQL_ROOT_PASSWORD:  <set to the key 'DB_PASSWORD' in secret 'bookstore-db-secret'>    Optional: false
      MYSQL_DATABASE:       <set to the key 'DB_NAME' in secret 'bookstore-db-secret'>        Optional: false
      MYSQL_USER:           <set to the key 'DB_USER' in secret 'bookstore-db-secret'>        Optional: false
      MYSQL_PASSWORD:       <set to the key 'DB_PASSWORD' in secret 'bookstore-db-secret'>    Optional: false
      REPL_USER:            <set to the key 'REPL_USER' in secret 'bookstore-db-secret'>      Optional: false
      REPL_PASSWORD:        <set to the key 'REPL_PASSWORD' in secret 'bookstore-db-secret'>  Optional: false
    Mounts:
      /var/lib/mysql from data (rw)
   repl-init:
    Image:      mysql:8.4
    Port:       <none>
    Host Port:  <none>
    Command:
      bash
      -lc
    Args:
      echo "[repl-init] Esperando MySQL local..."
      for i in $(seq 1 180); do
        mysqladmin --protocol=TCP -h 127.0.0.1 -p"$MYSQL_ROOT_PASSWORD" ping >/dev/null 2>&1 && break
        sleep 2
      done
      echo "[repl-init] Esperando primario..."
      for i in $(seq 1 180); do
        mysqladmin --protocol=TCP -h mysql-bookstore-primary.bookstore.svc.cluster.local -u root -p"$MYSQL_ROOT_PASSWORD" ping >/dev/null 2>&1 && break
        sleep 2
      done
      echo "[repl-init] Asegurando usuario de replicación en primario SIN binlog..."
      for i in $(seq 1 30); do
        mysql --protocol=TCP -h mysql-bookstore-primary.bookstore.svc.cluster.local -u root -p"$MYSQL_ROOT_PASSWORD" -e "
          SET SQL_LOG_BIN=0;
          CREATE USER IF NOT EXISTS '${REPL_USER}'@'%' IDENTIFIED BY '${REPL_PASSWORD}';
          GRANT REPLICATION SLAVE, REPLICATION CLIENT ON *.* TO '${REPL_USER}'@'%';
          FLUSH PRIVILEGES;
          SET SQL_LOG_BIN=1;" && break
        echo "[repl-init] Reintentando crear usuario... ($i/30)"; sleep 3
      done
      echo "[repl-init] Configurando CHANGE REPLICATION (GET_SOURCE_PUBLIC_KEY=1)..."
      for i in $(seq 1 30); do
        mysql --protocol=TCP -h 127.0.0.1 -u root -p"$MYSQL_ROOT_PASSWORD" -e "
          STOP REPLICA; RESET REPLICA ALL;
          CHANGE REPLICATION SOURCE TO
            SOURCE_HOST='mysql-bookstore-primary.bookstore.svc.cluster.local',
            SOURCE_USER='${REPL_USER}',
            SOURCE_PASSWORD='${REPL_PASSWORD}',
            SOURCE_AUTO_POSITION=1,
            GET_SOURCE_PUBLIC_KEY=1;
          START REPLICA;" && break
        echo "[repl-init] Reintentando configurar replicación... ($i/30)"; sleep 3
      done
      echo "[repl-init] OK, sidecar vivo."
      tail -f /dev/null
      
    Requests:
      cpu:     50m
      memory:  64Mi
    Environment:
      MYSQL_ROOT_PASSWORD:  <set to the key 'DB_PASSWORD' in secret 'bookstore-db-secret'>    Optional: false
      REPL_USER:            <set to the key 'REPL_USER' in secret 'bookstore-db-secret'>      Optional: false
      REPL_PASSWORD:        <set to the key 'REPL_PASSWORD' in secret 'bookstore-db-secret'>  Optional: false
    Mounts:                 <none>
  Volumes:
   data:
    Type:          EmptyDir (a temporary directory that shares a pod's lifetime)
    Medium:        
    SizeLimit:     <unset>
  Node-Selectors:  <none>
  Tolerations:     <none>
Volume Claims:     <none>
Events:            <none>

